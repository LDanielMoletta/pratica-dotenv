{
  "name": "pratica-dotenv",
  "version": "1.0.0",
  "description": "Lista de exercícios - Variáveis de ambiente com dotenv (exercícios 1 a 5) - Node.js e TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "start:dev": "cross-env NODE_ENV=development ts-node src/server.ts",
    "start:prod": "cross-env NODE_ENV=production ts-node src/server.ts",
    "dev": "nodemon src/server.ts",
    "print:config": "ts-node src/server.ts --print-config",
    "print:config:dev": "cross-env NODE_ENV=development ts-node src/server.ts --print-config",
    "print:config:prod": "cross-env NODE_ENV=production ts-node src/server.ts --print-config",
    "test:ex5": "node -r ts-node/register src/teste-exercicio-05.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "keywords": [
    "dotenv",
    "environment",
    "config",
    "typescript",
    "nodejs"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.0",
    "env-schema": "^6.0.0",
    "express": "^5.2.1",
    "joi": "^17.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.30.0"
  },
  "private": true
}