# ============================================================
# .env.example = CONTRATO DE AMBIENTE DO TIME (somente modelo).
# Copie para o seu arquivo local e preencha:
#   cp .env.example .env.dev     (desenvolvimento)
#   cp .env.example .env.prod    (produção)
# NUNCA versionar os arquivos .env* reais.
# Rode `npm run check:env` antes de `npm run dev`: o hook predev
# bloqueia a subida se algo estiver faltando ou se houver valor real aqui.
#
# Regras:
# - linhas comentadas com a palavra "opcional" marcam a variável seguinte
#   como dispensável (a configuração aplica um padrão seguro);
# - segredos (SENHA/KEY/TOKEN) ficam VAZIOS ou como <placeholder>;
# - toda variável nova precisa entrar neste arquivo, senão o time inteiro
#   perde a noção do que precisa preencher.
# ============================================================

# Porta HTTP do servidor (texto no arquivo; o módulo de configuração converte para número)
PORT=3000

# Host do banco de dados (endereço, não credencial)
DB_HOST=localhost

# Senha do banco — valor real NUNCA entra aqui
DB_PASSWORD=

# Chave da API do serviço externo — valor real NUNCA entra aqui
API_KEY=

# Caminho do arquivo de log. Aceita interpolação: ${NODE_ENV} vira
# development/production. O caminho é ancorado na raiz do projeto —
# valores com ".." que saiam da raiz são REJEITADOS na subida.
LOG_PATH=./logs/${NODE_ENV}.log

# Nível mínimo do log: debug | info | warn | error
# (desenvolvimento costuma querer debug; produção, info)
LOG_LEVEL=info